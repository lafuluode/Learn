        <mxCell id="103" value="创建并注册" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4f76a8;fontSize=12;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="21" target="23">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="500"/>
              <mxPoint x="980" y="500"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="104" value="实现" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4f76a8;fontSize=12;dashed=1;endArrow=block;endFill=0;" edge="1" parent="1" source="23" target="22">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="105" value="调用领域行为" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4f76a8;fontSize=12;endArrow=block;endFill=1;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="23" target="34">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="106" value="拥有 0..Capacity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#5c9a42;fontSize=12;startArrow=diamond;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1" source="34" target="33">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="107" value="包含 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#5c9a42;fontSize=12;endArrow=block;endFill=1;" edge="1" parent="1" source="33" target="32">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="108" value="通过 ConfigId 引用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#5c9a42;fontSize=12;endArrow=block;endFill=1;" edge="1" parent="1" source="32" target="31">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="109" value="加载静态配置" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#805a91;fontSize=12;dashed=1;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="41" target="31">
