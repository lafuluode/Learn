  </diagram>
  <diagram id="inventory-add-flow" name="添加物品主流程">
    <mxGraphModel dx="1560" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="f0"/>
        <mxCell id="f1" parent="f0"/>
        <mxCell id="f2" value="一次 AddItem 从业务命令到 UI 刷新的完整流向" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="f1">
          <mxGeometry x="50" y="30" width="1500" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="f10" value="&lt;b&gt;玩法 / 奖励系统&lt;/b&gt;&lt;br&gt;发出 AddItem(configId, count)&lt;br&gt;不直接修改背包数组" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#666666;fillColor=#f5f5f5;fontSize=14;fontColor=#333333;arcSize=10;" vertex="1" parent="f1">
          <mxGeometry x="50" y="130" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="f11" value="&lt;b&gt;InventoryService&lt;/b&gt;&lt;br&gt;查 ItemDefinition&lt;br&gt;组织一次业务用例" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#6c8ebf;fillColor=#eaf2ff;fontSize=14;fontColor=#17365d;arcSize=10;" vertex="1" parent="f1">
          <mxGeometry x="310" y="130" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="f12" value="&lt;b&gt;Inventory.TryAdd&lt;/b&gt;&lt;br&gt;先合并未满堆叠&lt;br&gt;再占用空 Slot，并维护不变量" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#82b366;fillColor=#eaf6e9;fontSize=14;fontColor=#234d1a;arcSize=10;" vertex="1" parent="f1">
          <mxGeometry x="570" y="130" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="f13" value="&lt;b&gt;InventoryResult + ChangeSet&lt;/b&gt;&lt;br&gt;成功 / 失败原因&lt;br&gt;实际加入数量 + 变化的 Slot" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#82b366;fillColor=#eaf6e9;fontSize=14;fontColor=#234d1a;arcSize=10;" vertex="1" parent="f1">
          <mxGeometry x="850" y="130" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="f14" value="&lt;b&gt;InventoryPresenter&lt;/b&gt;&lt;br&gt;订阅 Changed&lt;br&gt;生成只读展示数据" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#d79b00;fillColor=#fff2cc;fontSize=14;fontColor=#4b3200;arcSize=10;" vertex="1" parent="f1">
          <mxGeometry x="1130" y="130" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="f15" value="&lt;b&gt;InventoryView / CellView&lt;/b&gt;&lt;br&gt;刷新变化的格子&lt;br&gt;按 IconKey 请求 Sprite" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#d79b00;fillColor=#fff2cc;fontSize=14;fontColor=#4b3200;arcSize=10;" vertex="1" parent="f1">
          <mxGeometry x="1390" y="130" width="220" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="f20" value="&lt;b&gt;离线模式&lt;/b&gt;&lt;br&gt;Service 将 InventorySnapshot&lt;br&gt;交给 ISaveService" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#9673a6;fillColor=#f2eafa;fontSize=14;fontColor=#493057;arcSize=10;" vertex="1" parent="f1">
          <mxGeometry x="310" y="350" width="270" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="f21" value="&lt;b&gt;联网模式（未来替换同一入口）&lt;/b&gt;&lt;br&gt;Service 发命令给 Gateway&lt;br&gt;收到服务器 Snapshot / Delta 后再发布 Changed" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#9673a6;fillColor=#f2eafa;fontSize=14;fontColor=#493057;arcSize=10;dashed=1;" vertex="1" parent="f1">
          <mxGeometry x="650" y="350" width="360" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="f22" value="关键点：UI、奖励系统、存档和网络都不能绕过 IInventoryService 直接写 Inventory；这样规则只有一个入口。" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#999999;fillColor=#f5f5f5;fontSize=14;fontColor=#333333;align=left;spacingLeft=12;arcSize=8;" vertex="1" parent="f1">
          <mxGeometry x="50" y="530" width="1560" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="f100" value="命令" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;endArrow=block;endFill=1;" edge="1" parent="f1" source="f10" target="f11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f101" value="调用领域行为" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4f76a8;fontSize=12;endArrow=block;endFill=1;" edge="1" parent="f1" source="f11" target="f12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f102" value="返回结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#5c9a42;fontSize=12;endArrow=block;endFill=1;" edge="1" parent="f1" source="f12" target="f13"><mxGeometry relative="1" as="geometry"/></mxCell>
